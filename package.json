{
  "name": "dsh-pet-plus",
  "version": "0.1.0",
  "description": "dsh-pet 增强包：QQ（NapCat/OneBot 11）互通、好感度养成与喂食、喝水/久坐/番茄钟提醒、右键菜单互动与提示音。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "dsh-pet",
    "qq",
    "onebot",
    "napcat",
    "cordis"
  ],
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kongbaige11111/dsh-pet-plus.git"
  },
  "homepage": "https://github.com/kongbaige11111/dsh-pet-plus#readme",
  "bugs": {
    "url": "https://github.com/kongbaige11111/dsh-pet-plus/issues"
  },
  "author": "kongbaige11111"
}
